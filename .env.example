# Variables de entorno. Copia este archivo a .env (desarrollo) y completa solo lo que uses.
# .env está en .gitignore: NUNCA subas tus claves ni tus datos a git.
# Con todo vacío, la app funciona con los datos guardados en tu servidor (SQLite).

# Puerto del servidor en producción (npm start). Por defecto 3001.
PORT=

# Archivo SQLite con el viaje. Por defecto data/trip.db.
DB_PATH=

# Opcional: URL de Postgres. Si la defines, reemplaza a SQLite (docs/CONECTAR.md, paso 1).
DATABASE_URL=

# Código de acceso e invitación. Vacío = sin acceso protegido (solo red privada).
ACCESS_CODE=

# Cuentas iniciales, formato correo:admin,correo2:member. Solo se usan al crear la base.
SEED_USERS=
